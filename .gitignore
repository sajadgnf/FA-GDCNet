# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual envs
.venv/
venv/
env/

# Test & coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editor / local AI workflow (not part of the shipped project)
.idea/
.vscode/
.cursor/
openspec/

# OS
.DS_Store
Thumbs.db

# Downloaded model weights (use scripts/fetch_mclip.py)
models/

# Project data — DO NOT COMMIT scraped Instagram media (TOS).
# JSONL/TXT metadata under datasets/raw/ may be tracked; images must stay local.
datasets/raw/**/*.jpg
datasets/raw/**/*.jpeg
datasets/raw/**/*.webp
datasets/raw/**/*.png
datasets/raw/**/*.gif
artifacts/*
!artifacts/.gitkeep
reports/*.csv
reports/*.json
reports/*.png
reports/*.html
reports/explain/
reports/eval_run.log

# Keep directory placeholders
!datasets/.gitkeep
!artifacts/.gitkeep
!reports/.gitkeep
!notebooks/.gitkeep

# Allow markdown reports
!reports/*.md
